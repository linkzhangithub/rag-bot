  display: block;
  border: 2px dashed #475569;
  border-radius: 8px;
  padding: 20px;
  text-align: center;
  cursor: pointer;
  transition: all 0.3s;
}

.upload-area:hover:not(.uploading) {
  border-color: #3b82f6;
  background: rgba(59, 130, 246, 0.1);
}

.upload-area input {
  display: none;
}

.upload-icon {
  font-size: 32px;
  margin-bottom: 8px;
}

