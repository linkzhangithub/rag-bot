<template>
  <div class="app">
    <!-- 侧边栏 -->
    <aside class="sidebar">
      <div class="sidebar-header">
        <h1>📚 知识库问答</h1>
      </div>

      <!-- 上传区域 -->
      <div class="upload-section">
        <label class="upload-area" :class="{ uploading }">
          <input 
            type="file" 
            accept=".md,.txt" 
            @change="handleFileUpload"
            :disabled="uploading"
          />
          <div v-if="!uploading">
            <div class="upload-icon">📁</div>
            <div>点击上传文档</div>
          </div>
          <div v-else class="uploading">
            <div class="spinner"></div>
            <div>上传中...</div>
          </div>
        </label>
      </div>

      <!-- 文档列表 -->
      <div class="documents-section">
        <h3>已上传文档 ({{ documents.length }})</h3>
        <ul v-if="documents.length > 0" class="document-list">
          <li v-for="doc in documents" :key="doc.name" class="document-item">
            <div class="doc-info">
              <div class="doc-name">{{ doc.name }}</div>
              <div class="doc-chunks">{{ doc.chunks }} 个文本块</div>
            </div>
            <button @click="handleDelete(doc.name)" class="delete-btn">🗑️</button>
          </li>
        </ul>
        <p v-else class="empty-tip">暂无文档</p>
      </div>
    </aside>

    <!-- 主内容区 -->
    <main class="main-content">
      <!-- 聊天窗口 -->
      <div class="chat-container" ref="chatContainer">
        <div v-if="messages.length === 0" class="welcome">
          <h2>欢迎使用知识库问答系统</h2>
          <p>请先上传文档，然后我可以基于文档内容回答问题</p>
        </div>

        <div 
          v-for="(msg, index) in messages" 
          :key="index" 
          :class="['message', msg.role]"
        >
          <div class="message-content">
            {{ msg.content }}
          </div>
        </div>

        <div v-if="isGenerating" class="message assistant loading">
          <div class="message-content">
            <span class="typing-indicator">思考中...</span>
          </div>
        </div>
      </div>

      <!-- 输入区域 -->
      <div class="input-area">
        <textarea
          v-model="inputMessage"
          @keydown.enter.exact.prevent="sendMessage"
          placeholder="输入问题... (Enter发送, Shift+Enter换行)"
          :disabled="isGenerating"
          rows="3"
        ></textarea>
        <div class="input-actions">
          <button 
            v-if="isGenerating" 
            @click="stopGeneration" 
            class="stop-btn"
          >
            ⏹ 停止
          </button>
          <button 
            v-else 
            @click="sendMessage" 
            class="send-btn"
            :disabled="!inputMessage.trim()"
          >
            发送
          </button>
        </div>
      </div>
    </main>
  </div>
</template>

<script setup>
import { ref, nextTick } from 'vue'
import { useChatStream } from './composables/useChatStream'
import { useDocument } from './composables/useDocument'

// 聊天相关
const { messages, isGenerating, sendMessage: sendChatMessage, stop } = useChatStream()
const inputMessage = ref('')
const chatContainer = ref(null)

async function sendMessage() {
  if (!inputMessage.value.trim() || isGenerating.value) return
  
  const message = inputMessage.value
  inputMessage.value = ''
  
  await sendChatMessage(message)
  
  // 滚动到底部
  await nextTick()
  if (chatContainer.value) {
    chatContainer.value.scrollTop = chatContainer.value.scrollHeight
  }
}

function stopGeneration() {
  stop()
}

// 文档相关
const { documents, uploading, handleUpload, handleDelete } = useDocument()

async function handleFileUpload(event) {
  const file = event.target.files[0]
  if (!file) return
  
  try {
    await handleUpload(file)
    event.target.value = '' // 清空input
  } catch (error) {
    alert('上传失败: ' + error.message)
  }
}
</script>

<style scoped>
